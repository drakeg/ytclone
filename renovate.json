{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Keep Django on the supported 6.1 release line",
      "matchManagers": ["pip_requirements"],
      "matchPackageNames": ["Django"],
      "allowedVersions": ">=6.1,<6.2"
    },
    {
      "description": "Require manual review for major dependency upgrades",
      "matchManagers": ["pip_requirements"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
